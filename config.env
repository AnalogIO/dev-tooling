# Local E2E environment configuration for analog-dev.
#
# Plain KEY=VALUE (no shell expansion) so the same file works on macOS, Linux
# and Windows. Precedence, highest first:
#   1. environment variables
#   2. config.local.env (git-ignored, create it for per-machine overrides)
#   3. this file
#
# Examples:
#   API_PORT=5080 e2e up
#   PLATFORM=android e2e up
#   SIM_NAME="iPhone 17" e2e up

# --- Repositories (relative to this file, or absolute) ---------------------
CORE_DIR=analog-core
APP_DIR=mobile_app
CORE_REPO=https://github.com/AnalogIO/analog-core.git
APP_REPO=https://github.com/AnalogIO/mobile_app.git
# Branch checked out by `e2e setup --clone`. Leave empty to use the default branch.
CORE_REF=om/magic-link-registration
APP_REF=

# --- Backend ---------------------------------------------------------------
API_PORT=8080
# Leave empty to derive http://localhost:${API_PORT}
API_BASE_URL=
# 0.0.0.0 lets a physical phone on the LAN reach the backend.
API_BIND=0.0.0.0
DEEP_LINK_BASE=analogcoffeecard-dev://cafeanalog.dk/
SMTP_HOST=127.0.0.1
# Leave empty to use MAILHOG_SMTP_PORT.
SMTP_PORT=

# --- Database --------------------------------------------------------------
DB_PORT=1433
DB_BIND=127.0.0.1
DB_USER=sa
DB_PASSWORD=Your_password123
DB_NAME=master
MSSQL_IMAGE=mcr.microsoft.com/mssql/server:2022-latest

# --- MailHog ---------------------------------------------------------------
MAILHOG_HTTP_PORT=8025
MAILHOG_SMTP_PORT=1025
MAILHOG_BIND=127.0.0.1
# Leave empty to derive http://127.0.0.1:${MAILHOG_HTTP_PORT}
MAILHOG_URL=
MAILHOG_IMAGE=mailhog/mailhog:latest

# --- Device ----------------------------------------------------------------
# auto: iOS on macOS, Android elsewhere. Also: ios, android, none.
PLATFORM=auto
# A simulator UDID or Android serial. Empty means auto-select/launch.
DEVICE=
# Set to 1 to never boot or require a device (backend-only workflows).
NO_DEVICE=0
# macOS: preferred simulator; falls back to the first available iPhone.
SIM_NAME=iPhone 16 Pro
SIM_UDID=
# Android: preferred AVD; falls back to the first AVD.
ANDROID_AVD=
ANDROID_SERIAL=
# Android emulators reach the host through 10.0.2.2 automatically. For a
# physical phone use e.g. http://192.168.1.10:8080.
ANDROID_API_BASE_URL=

# The development flavor shared by iOS and Android.
APP_ID=dk.analogio.analog.dev
APP_FLAVOR=development
APP_SCHEME=analogcoffeecard-dev
